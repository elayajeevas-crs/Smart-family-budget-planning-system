# PostgreSQL connection (matches docker-compose.yml in the project root)
DATABASE_URL="postgresql://budget_user:budget_password@localhost:5432/smart_family_budget?schema=public"

# Secret used to sign JWTs. Use a long random string (32+ characters).
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=7d

PORT=5000
CLIENT_URL=http://localhost:5173

# bcrypt cost factor (10-12 recommended)
BCRYPT_ROUNDS=10

# Offset (minutes) from UTC used to decide what "today" means. 330 = India (IST)
TZ_OFFSET_MINUTES=330
NODE_ENV=development
