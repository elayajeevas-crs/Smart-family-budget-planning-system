generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MEMBER
}

enum IncomeCategory {
  SALARY
  BUSINESS
  FREELANCE
  INVESTMENT
  RENTAL
  BONUS
  OTHER
}

enum ExpenseCategory {
  FOOD
  GROCERIES
  HOUSING
  ELECTRICITY
  WATER
  INTERNET
  TRANSPORTATION
  EDUCATION
  HEALTHCARE
  SHOPPING
  ENTERTAINMENT
  EMI_LOAN
  INSURANCE
  BILLS
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum SavingsCategory {
  EMERGENCY_FUND
  LAPTOP
  EDUCATION
  VACATION
  VEHICLE
  HOUSE
  OTHER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membership    FamilyMember?
  incomes       Income[]
  expenses      Expense[]
  recurring     RecurringExpense[]
  payments      Payment[]
  contributions SavingsContribution[]
  notifications Notification[]
}

model Family {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members       FamilyMember[]
  incomes       Income[]
  expenses      Expense[]
  budgets       Budget[]
  savingsGoals  SavingsGoal[]
  recurring     RecurringExpense[]
  payments      Payment[]
  notifications Notification[]
}

model FamilyMember {
  id        String   @id @default(cuid())
  familyId  String
  userId    String   @unique
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family   Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomes  Income[]
  expenses Expense[]

  @@index([familyId])
}

model Income {
  id          String              @id @default(cuid())
  familyId    String
  createdById String
  memberId    String?
  amount      Decimal             @db.Decimal(12, 2)
  source      String
  category    IncomeCategory
  date        DateTime
  description String?
  isRecurring Boolean             @default(false)
  frequency   RecurrenceFrequency?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  family    Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User          @relation(fields: [createdById], references: [id])
  member    FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([familyId, date])
  @@index([familyId, category])
  @@index([createdById])
}

model Expense {
  id                 String          @id @default(cuid())
  familyId           String
  createdById        String
  memberId           String?
  recurringExpenseId String?
  amount             Decimal         @db.Decimal(12, 2)
  category           ExpenseCategory
  description        String
  date               DateTime
  paymentMethod      PaymentMethod   @default(UPI)
  isRecurring        Boolean         @default(false)
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  family           Family            @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy        User              @relation(fields: [createdById], references: [id])
  member           FamilyMember?     @relation(fields: [memberId], references: [id], onDelete: SetNull)
  recurringExpense RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)

  @@index([familyId, date])
  @@index([familyId, category])
  @@index([createdById])
}

model Budget {
  id          String   @id @default(cuid())
  familyId    String
  month       Int
  year        Int
  totalAmount Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family     Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  categories BudgetCategory[]

  @@unique([familyId, year, month])
}

model BudgetCategory {
  id        String          @id @default(cuid())
  budgetId  String
  category  ExpenseCategory
  amount    Decimal         @db.Decimal(12, 2)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, category])
}

model SavingsGoal {
  id            String          @id @default(cuid())
  familyId      String
  name          String
  category      SavingsCategory @default(OTHER)
  targetAmount  Decimal         @db.Decimal(12, 2)
  currentAmount Decimal         @default(0) @db.Decimal(12, 2)
  targetDate    DateTime
  description   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  family        Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  contributions SavingsContribution[]

  @@index([familyId])
}

model SavingsContribution {
  id        String   @id @default(cuid())
  goalId    String
  userId    String
  amount    Decimal  @db.Decimal(12, 2)
  date      DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id])

  @@index([goalId, date])
}

model RecurringExpense {
  id                String              @id @default(cuid())
  familyId          String
  createdById       String
  name              String
  amount            Decimal             @db.Decimal(12, 2)
  frequency         RecurrenceFrequency @default(MONTHLY)
  nextDueDate       DateTime
  category          ExpenseCategory
  paymentMethod     PaymentMethod       @default(UPI)
  autoCreateExpense Boolean             @default(false)
  reminderDays      Int                 @default(3)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  family    Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])
  expenses  Expense[]

  @@index([familyId, nextDueDate])
}

model Payment {
  id          String          @id @default(cuid())
  familyId    String
  createdById String
  name        String
  amount      Decimal         @db.Decimal(12, 2)
  dueDate     DateTime
  category    ExpenseCategory
  status      PaymentStatus   @default(PENDING)
  notes       String?
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([familyId, status, dueDate])
}

model Notification {
  id        String               @id @default(cuid())
  userId    String
  familyId  String
  title     String
  message   String
  severity  NotificationSeverity @default(INFO)
  isRead    Boolean              @default(false)
  dedupeKey String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, isRead, createdAt])
}
